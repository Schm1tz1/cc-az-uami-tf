# Copy to .env and fill in. The scripts in scripts/ load .env automatically.
# .env is in .gitignore. Do not commit it.

# Confluent Cloud API key and secret (Cloud resource management, not a Kafka key).
# The key needs the OrganizationAdmin role. Used by the confluent/ root.
CONFLUENT_CLOUD_API_KEY="<cloud-api-key>"
CONFLUENT_CLOUD_API_SECRET="<cloud-api-secret>"

# Kafka cluster. Used by gen-env.sh and test-on-vm.sh.
# Bootstrap server: host and port only, without SASL_SSL://
KAFKA_BOOTSTRAP="<bootstrap-host>:9092"
# Cluster ID, for example lkc-abc123
KAFKA_CLUSTER_ID="<lkc-...>"
# Topic for the produce test. The identity pool needs write access to it.
KAFKA_TOPIC="<topic-name>"

# Optional: Azure subscription. Used if subscription_id is not set in terraform.tfvars.
# ARM_SUBSCRIPTION_ID="<subscription-id>"
